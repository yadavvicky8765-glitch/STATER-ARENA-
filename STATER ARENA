<!DOCTYPE html>
<html lang="hi">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1">
<meta name="theme-color" content="#090d18">
<title>Starter Arena</title>
<link rel="icon" href="logo.png">
<script src="https://cdn.tailwindcss.com"></script>
<style>
:root{--bg:#090d18;--panel:#111a2b;--line:#26334a;--muted:#91a0b8;--lime:#b7f34a;--blue:#4da3ff}
*{box-sizing:border-box}body{margin:0;background:radial-gradient(circle at 80% -10%,#1c3151 0,transparent 35%),var(--bg);color:#f4f7fb;font-family:system-ui,-apple-system,Segoe UI,sans-serif}
button,input,textarea,select{font:inherit}button{cursor:pointer}.wrap{max-width:1100px;margin:auto;padding:16px}.panel{background:linear-gradient(145deg,#141f33,#0f1726);border:1px solid var(--line);border-radius:18px;padding:16px;box-shadow:0 12px 35px #0003}.muted{color:var(--muted)}.lime{color:var(--lime)}.btn{border:0;border-radius:12px;padding:11px 15px;font-weight:750;background:var(--lime);color:#111827}.btn2{background:#202d43;color:#fff;border:1px solid #34435d;border-radius:12px;padding:10px 14px;font-weight:650}.danger{background:#51232b;color:#ffd9de;border:1px solid #79333d}.field{width:100%;background:#0b1220;border:1px solid #34435d;color:white;border-radius:11px;padding:12px;outline:none}.field:focus{border-color:var(--lime)}.tag{font-size:11px;padding:4px 8px;border-radius:30px;background:#25364d;color:#b9d0ee}.hidden{display:none!important}.grid2{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px}.grid3{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px}.nav{display:flex;gap:8px;overflow:auto;padding:4px 0 12px}.nav button{white-space:nowrap}.match{border:1px solid #2a3a53;border-radius:15px;padding:14px;background:#0d1625}.stat{font-size:25px;font-weight:850}.small{font-size:12px}.toast{position:fixed;bottom:20px;left:50%;transform:translateX(-50%);background:#e8f7c8;color:#17210a;padding:12px 18px;border-radius:12px;font-weight:700;z-index:50;box-shadow:0 8px 25px #0007}
@media(max-width:620px){.grid2,.grid3{grid-template-columns:1fr 1fr}.wrap{padding:12px}.panel{padding:13px}.stat{font-size:21px}}
</style>
</head>
<body>
<div class="wrap">
<header class="flex items-center justify-between gap-3 py-3">
 <div class="flex items-center gap-3"><div class="w-11 h-11 rounded-2xl flex items-center justify-center font-black text-xl" style="background:var(--lime);color:#111">SA</div><div><div class="font-black text-xl tracking-wide">STARTER <span class="lime">ARENA</span></div><div class="small muted">TOURNAMENT • COMPETE • WIN</div></div></div>
 <div class="text-right"><div id="topUser" class="font-bold text-sm">Guest</div><div id="topCoins" class="small lime">🪙 0 Coins</div></div>
</header>
<section id="auth" class="max-w-lg mx-auto mt-8 panel">
 <div class="text-center mb-5"><div class="text-3xl font-black">WELCOME TO <span class="lime">ARENA</span></div><p class="muted text-sm mt-1">Login करें या नया खिलाड़ी अकाउंट बनाएं</p></div>
 <div class="nav"><button class="btn flex-1" id="loginTab" onclick="authMode='login';renderAuth()">LOGIN</button><button class="btn2 flex-1" id="signupTab" onclick="authMode='signup';renderAuth()">SIGN UP</button><button class="btn2 flex-1" onclick="authMode='admin';renderAuth()">ADMIN</button></div>
 <div id="authFields" class="space-y-3"></div><p class="small muted mt-4">Demo build: इस डिवाइस पर डेटा सेव होता है।</p>
</section>
<main id="app" class="hidden">
 <div class="panel mt-4 flex flex-wrap items-center justify-between gap-3"><div><div class="text-sm muted">YOUR ARENA WALLET</div><div class="text-3xl font-black lime" id="walletTotal">🪙 0</div></div><div class="flex gap-2"><button class="btn2" onclick="showTab('wallet')">Wallet</button><button class="btn2 danger" onclick="logout()">Logout</button></div></div>
 <nav class="nav mt-3" id="userNav"></nav>
 <section id="view" class="space-y-4"></section>
</main>
<div id="toast" class="toast hidden"></div>
</div>
<script>
const KEY='starterArena_v1';
let db=load(), current=null, authMode='login', activeTab='home';
function seed(){return {users:[],matches:[{id:1,title:'Solo Showdown',game:'Free Fire',mode:'Solo',map:'Bermuda',entry:10,prize:100,slots:48,joined:[],roomId:'',roomPass:'',status:'Upcoming',time:'Today 7:00 PM'}],messages:[{id:1,title:'Welcome to Starter Arena',body:'टूर्नामेंट में भाग लेने से पहले नियम पढ़ें।',date:new Date().toLocaleString('hi-IN')}],requests:[],nextId:2}}
function load(){try{return JSON.parse(localStorage.getItem(KEY))||seed()}catch(e){return seed()}}
function save(){localStorage.setItem(KEY,JSON.stringify(db));syncHeader()}
function esc(s){return String(s??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]))}
function toast(s){let t=document.getElementById('toast');t.textContent=s;t.classList.remove('hidden');setTimeout(()=>t.classList.add('hidden'),2400)}
function syncHeader(){let u=current?db.users.find(x=>x.id===current):null;document.getElementById('topUser').textContent=u?u.name:(current==='admin'?'Administrator':'Guest');document.getElementById('topCoins').textContent=current==='admin'?'ADMIN CONTROL':`🪙 ${u?.coins||0} Coins`;if(u){document.getElementById('walletTotal').textContent='🪙 '+u.coins}}
function renderAuth(){document.getElementById('loginTab').className=authMode==='login'?'btn flex-1':'btn2 flex-1';document.getElementById('signupTab').className=authMode==='signup'?'btn flex-1':'btn2 flex-1';let box=document.getElementById('authFields');if(authMode==='admin'){box.innerHTML=`<input id="auser" class="field" placeholder="Admin username"><input id="apass" type="password" class="field" placeholder="Admin password"><button class="btn w-full" onclick="adminLogin()">ADMIN LOGIN</button><p class="small muted">पहली बार लॉगिन: admin / ChangeMe123! (लॉगिन के बाद बदलें)</p>`}else if(authMode==='signup'){box.innerHTML=`<input id="name" class="field" placeholder="आपका नाम"><input id="username" class="field" placeholder="Username"><input id="password" type="password" class="field" placeholder="Password"><input id="phone" class="field" placeholder="Mobile (optional)"><button class="btn w-full" onclick="signup()">CREATE ACCOUNT</button>`}else{box.innerHTML=`<input id="username" class="field" placeholder="Username"><input id="password" type="password" class="field" placeholder="Password"><button class="btn w-full" onclick="login()">LOGIN TO ARENA</button>`}}
function adminLogin(){if(document.getElementById('auser').value==='admin'&&document.getElementById('apass').value==='ChangeMe123!'){current='admin';openApp();showTab('admin')}else toast('Admin login गलत है')}
function signup(){let name=document.getElementById('name').value.trim(),username=document.getElementById('username').value.trim().toLowerCase(),password=document.getElementById('password').value,phone=document.getElementById('phone').value.trim();if(!name||!username||password.length<6)return toast('नाम, username और 6+ अक्षर का password भरें');if(db.users.some(u=>u.username===username))return toast('यह username पहले से मौजूद है');let u={id:Date.now(),name,username,password,phone,coins:50,joined:[],created:new Date().toISOString()};db.users.push(u);save();current=u.id;openApp();toast('Account बन गया! 50 welcome coins मिले')}
function login(){let un=document.getElementById('username').value.trim().toLowerCase(),pw=document.getElementById('password').value,u=db.users.find(x=>x.username===un&&x.password===pw);if(!u)return toast('Username या password गलत है');current=u.id;openApp()}
function logout(){current=null;document.getElementById('app').classList.add('hidden');document.getElementById('auth').classList.remove('hidden');renderAuth()}
function openApp(){document.getElementById('auth').classList.add('hidden');document.getElementById('app').classList.remove('hidden');syncHeader();showTab(current==='admin'?'admin':'home')}
function user(){return db.users.find(x=>x.id===current)}
function showTab(tab){activeTab=tab;let admin=current==='admin';let tabs=admin?[['admin','Dashboard'],['matches','Manage Matches'],['players','Players'],['requests','Coin Requests'],['messages','Messages'],['settings','Settings']]:[['home','Home'],['matches','Matches'],['wallet','Wallet'],['messages','Messages'],['profile','Profile']];document.getElementById('userNav').innerHTML=tabs.map(([k,n])=>`<button class="${tab===k?'btn':'btn2'}" onclick="showTab('${k}')">${n}</button>`).join('');let v=document.getElementById('view');if(tab==='home')v.innerHTML=homeView();if(tab==='matches')v.innerHTML=matchesView(admin);if(tab==='wallet')v.innerHTML=walletView();if(tab==='messages')v.innerHTML=messagesView();if(tab==='profile')v.innerHTML=profileView();if(tab==='admin')v.innerHTML=adminView();if(tab==='players')v.innerHTML=playersView();if(tab==='requests')v.innerHTML=requestsView();if(tab==='settings')v.innerHTML=settingsView();syncHeader()}
function homeView(){let u=user();return `<div class="grid3"><div class="panel"><div class="muted small">AVAILABLE COINS</div><div class="stat lime">${u.coins}</div></div><div class="panel"><div class="muted small">JOINED MATCHES</div><div class="stat">${u.joined.length}</div></div><div class="panel"><div class="muted small">TOTAL MATCHES</div><div class="stat">${db.matches.length}</div></div></div><div class="panel"><h2 class="font-black text-xl mb-2">🏆 Featured Matches</h2>${db.matches.slice(0,3).map(matchCard).join('')||'<p class="muted">अभी मैच उपलब्ध नहीं हैं।</p>'}</div><div class="panel"><h2 class="font-bold mb-2">📢 Latest Notice</h2>${db.messages.slice(-1).map(m=>`<b>${esc(m.title)}</b><p class="muted text-sm">${esc(m.body)}</p>`).join('')||'कोई नया मैसेज नहीं'}</div>`}
function matchCard(m){return `<div class="match my-2"><div class="flex justify-between gap-2"><b>${esc(m.title)}</b><span class="tag">${esc(m.status)}</span></div><p class="muted small mt-1">${esc(m.game)} • ${esc(m.mode)} • ${esc(m.map)} • ${esc(m.time)}</p><div class="grid3 my-3 text-sm"><div>Entry<br><b class="lime">${m.entry} coins</b></div><div>Prize<br><b>${m.prize} coins</b></div><div>Slots<br><b>${m.joined.length}/${m.slots}</b></div></div>${current==='admin'?`<button class="btn2 w-full" onclick="editMatch(${m.id})">Edit Match / Room Details</button>`:`<button class="btn w-full" onclick="joinMatch(${m.id})" ${m.status!=='Upcoming'?'disabled':''}>${m.joined.includes(current)?'Joined':'JOIN MATCH'}</button>${m.joined.includes(current)?`<p class="small muted mt-2">Room details: ${m.roomId?esc(m.roomId)+' / '+esc(m.roomPass):'Admin अभी Room ID/Password जारी नहीं किया है।'}</p>`:''}`}</div>`}
function matchesView(admin){return `<div class="panel"><h2 class="font-black text-xl mb-3">🎮 ${admin?'All Tournament Matches':'Available Matches'}</h2>${db.matches.map(matchCard).join('')||'<p class="muted">कोई मैच नहीं।</p>'}</div>`}
function joinMatch(id){let m=db.matches.find(x=>x.id===id),u=user();if(!m||m.status!=='Upcoming')return toast('यह मैच अभी join नहीं हो सकता');if(m.joined.includes(current))return toast('आप पहले से joined हैं');if(m.joined.length>=m.slots)return toast('Slots भर चुके हैं');if(u.coins<m.entry)return toast('Coins पर्याप्त नहीं हैं');u.coins-=m.entry;u.joined.push(id);m.joined.push(current);save();showTab('matches');toast('Match successfully joined')}
function walletView(){let u=user();return `<div class="panel"><h2 class="font-black text-xl">🪙 My Wallet</h2><div class="stat lime my-2">${u.coins} Coins</div><p class="muted small">ये केवल ऐप के virtual demo coins हैं। इनका real-money value नहीं है।</p><button class="btn w-full mt-3" onclick="freeClaim()">FREE DAILY CLAIM (+20)</button></div><div class="panel"><h3 class="font-bold mb-2">Request Coins</h3><input id="reqAmount" type="number" min="1" class="field mb-2" placeholder="Coins amount"><textarea id="reqNote" class="field mb-2" placeholder="Request note (optional)"></textarea><button class="btn w-full" onclick="requestCoins()">SEND REQUEST</button></div><div class="panel"><h3 class="font-bold mb-2">My Requests</h3>${db.requests.filter(r=>r.userId===current).map(r=>`<p class="text-sm border-b border-slate-700 py-2">${r.amount} coins • ${esc(r.status)}</p>`).join('')||'<p class="muted small">कोई request नहीं।</p>'}</div>`}
function freeClaim(){let u=user(),day=new Date().toDateString();u.claims=u.claims||{};if(u.claims[day])return toast('आज का claim हो चुका है');u.claims[day]=true;u.coins+=20;save();showTab('wallet');toast('20 free coins मिल गए')}
function requestCoins(){let amount=Number(document.getElementById('reqAmount').value);if(!Number.isInteger(amount)||amount<1)return toast('सही amount डालें');db.requests.push({id:Date.now(),userId:current,amount,note:document.getElementById('reqNote').value,status:'Pending'});save();showTab('wallet');toast('Request admin को भेज दी गई')}
function messagesView(){return `<div class="panel"><h2 class="font-black text-xl mb-3">📢 Arena Messages</h2>${db.messages.slice().reverse().map(m=>`<div class="match my-2"><b>${esc(m.title)}</b><p class="text-sm mt-1">${esc(m.body)}</p><p class="muted small mt-2">${esc(m.date)}</p></div>`).join('')||'<p class="muted">अभी कोई message नहीं।</p>'}</div>`}
function profileView(){let u=user();return `<div class="panel"><h2 class="font-black text-xl mb-3">👤 Player Profile</h2><p><span class="muted">Name:</span> ${esc(u.name)}</p><p><span class="muted">Username:</span> @${esc(u.username)}</p><p><span class="muted">Phone:</span> ${esc(u.phone||'Not added')}</p><p><span class="muted">Player ID:</span> ${u.id}</p></div>`}
function adminView(){return `<div class="grid3"><div class="panel"><div class="small muted">PLAYERS</div><div class="stat">${db.users.length}</div></div><div class="panel"><div class="small muted">MATCHES</div><div class="stat">${db.matches.length}</div></div><div class="panel"><div class="small muted">PENDING REQUESTS</div><div class="stat">${db.requests.filter(r=>r.status==='Pending').length}</div></div></div><div class="panel"><h2 class="font-black text-xl mb-3">➕ Create Tournament</h2><div class="grid2"><input id="mtitle" class="field" placeholder="Match title"><input id="mgame" class="field" value="Free Fire" placeholder="Game"><input id="mmode" class="field" placeholder="Mode (Solo/Duo/Squad)"><input id="mmap" class="field" placeholder="Map"><input id="mentry" type="number" class="field" placeholder="Entry coins"><input id="mprize" type="number" class="field" placeholder="Prize coins"><input id="mslots" type="number" class="field" placeholder="Slots"><input id="mtime" class="field" placeholder="Date / Time"></div><button class="btn w-full mt-3" onclick="createMatch()">CREATE MATCH</button></div><div class="panel"><h2 class="font-black text-xl mb-3">✉️ Create Announcement</h2><input id="msgtitle" class="field mb-2" placeholder="Message title"><textarea id="msgbody" class="field mb-2" placeholder="Write announcement..."></textarea><button class="btn w-full" onclick="sendMessage()">PUBLISH MESSAGE</button></div><div class="panel"><h2 class="font-bold mb-2">Quick Admin Actions</h2><p class="muted small">Match की Room ID/Password, status और details बदलने के लिए Manage Matches खोलें।</p><button class="btn2 mt-2" onclick="showTab('matches')">MANAGE MATCHES</button></div>`}
function createMatch(){let title=document.getElementById('mtitle').value.trim(),entry=Number(document.getElementById('mentry').value),prize=Number(document.getElementById('mprize').value),slots=Number(document.getElementById('mslots').value);if(!title||entry<0||prize<0||slots<1)return toast('Match की सही details भरें');db.matches.push({id:db.nextId++,title,game:document.getElementById('mgame').value||'Free Fire',mode:document.getElementById('mmode').value||'Solo',map:document.getElementById('mmap').value||'Bermuda',entry,prize,slots,joined:[],roomId:'',roomPass:'',status:'Upcoming',time:document.getElementById('mtime').value||'Time to be announced'});save();showTab('matches');toast('Tournament create हो गया')}
function editMatch(id){let m=db.matches.find(x=>x.id===id);let roomId=prompt('Room ID डालें',m.roomId||'');if(roomId===null)return;let roomPass=prompt('Room Password डालें',m.roomPass||'');if(roomPass===null)return;let status=prompt('Status: Upcoming / Live / Completed / Cancelled',m.status);if(status===null)return;m.roomId=roomId;m.roomPass=roomPass;m.status=status;save();showTab('matches');toast('Match details update हो गईं')}
function playersView(){return `<div class="panel"><h2 class="font-black text-xl mb-3">👥 Registered Players</h2>${db.users.map(u=>`<div class="match my-2 flex justify-between gap-2 items-center"><div><b>${esc(u.name)}</b><p class="small muted">@${esc(u.username)} • ${u.coins} coins</p></div><button class="btn2" onclick="adjustCoins(${u.id})">Adjust Coins</button></div>`).join('')||'<p class="muted">अभी कोई player नहीं।</p>'}</div>`}
function adjustCoins(id){let u=db.users.find(x=>x.id===id),n=prompt('Coins add करने के लिए positive या deduct के लिए negative number', '50');if(n===null)return;n=Number(n);if(!Number.isInteger(n)||u.coins+n<0)return toast('Invalid coin amount');u.coins+=n;save();showTab('players');toast('Wallet updated')}
function requestsView(){return `<div class="panel"><h2 class="font-black text-xl mb-3">🧾 Coin Requests</h2>${db.requests.map(r=>{let u=db.users.find(x=>x.id===r.userId);return `<div class="match my-2"><b>${esc(u?.name||'Unknown')}</b><p class="small muted">${r.amount} coins • ${esc(r.note)} • ${esc(r.status)}</p>${r.status==='Pending'?`<div class="flex gap-2 mt-2"><button class="btn" onclick="resolveRequest(${r.id},true)">Approve</button><button class="btn2 danger" onclick="resolveRequest(${r.id},false)">Reject</button></div>`:''}</div>`}).join('')||'<p class="muted">कोई request नहीं।</p>'}</div>`}
function resolveRequest(id,yes){let r=db.requests.find(x=>x.id===id);if(!r||r.status!=='Pending')return;if(yes){let u=db.users.find(x=>x.id===r.userId);if(u)u.coins+=r.amount;r.status='Approved'}else r.status='Rejected';save();showTab('requests')}
function settingsView(){return `<div class="panel"><h2 class="font-black text-xl mb-2">⚙️ Admin Settings</h2><p class="muted small mb-3">यह प्रारंभिक offline demo है। इसमें admin login केवल demo password से सुरक्षित है; इसे public release से पहले Firebase Authentication और secure database rules से बदलना जरूरी है।</p><button class="btn2 danger" onclick="if(confirm('सभी local demo data मिट जाएगा। जारी रखें?')){localStorage.removeItem(KEY);db=seed();save();logout()}">RESET ALL DEMO DATA</button></div>`}
renderAuth();syncHeader();
</script>
</body>
</html>
